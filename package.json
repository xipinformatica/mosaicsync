{
  "name": "mosaicsync-development",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test tests/*.test.mjs",
    "test:groups": "node tools/run-test-group.mjs --list",
    "test:startup": "node tools/run-test-group.mjs startup",
    "test:newtab": "node tools/run-test-group.mjs newtab",
    "test:sync": "node tools/run-test-group.mjs sync",
    "test:recovery": "node tools/run-test-group.mjs recovery",
    "test:security": "node tools/run-test-group.mjs security",
    "test:browser": "node tools/run-test-group.mjs browser",
    "test:core": "node tools/run-test-group.mjs core",
    "test:release": "node tools/run-test-group.mjs release",
    "bench": "node tools/build.mjs && node bench/performance.mjs",
    "size": "node tools/build.mjs && node tools/size-report.mjs",
    "release:package": "python tools/package.py",
    "firefox:dev": "python tools/package.py --firefox-dev",
    "inventory": "node tools/complexity-inventory.mjs",
    "reachability": "node tools/runtime-reachability.mjs",
    "smoke:probe": "node tools/browser-smoke.mjs --probe",
    "smoke:prepare": "python tools/package.py --firefox-dev",
    "smoke:firefox": "python tools/package.py --firefox-dev && node tools/browser-smoke.mjs --browser=firefox",
    "smoke:chrome": "node tools/build.mjs && node tools/browser-smoke.mjs --browser=chrome",
    "smoke:browsers": "python tools/package.py --firefox-dev && node tools/browser-smoke.mjs --browser=all",
    "certify": "node tools/certify-release.mjs",
    "certify:mechanical": "node tools/certify-release.mjs --skip-browser-smoke"
  }
}
